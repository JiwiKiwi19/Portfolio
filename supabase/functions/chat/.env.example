# Secrets for the `chat` edge function. Set them in Lovable Cloud → Secrets
# (or `supabase secrets set KEY=value` with the Supabase CLI).

# Required — a free Gemini key from https://aistudio.google.com/apikey (no credit card needed)
CHAT_API_KEY=

# Optional — defaults to gemini-flash-latest (Google's newest Flash model)
CHAT_MODEL=

# Optional — any OpenAI-compatible endpoint. Defaults to Gemini's:
#   https://generativelanguage.googleapis.com/v1beta/openai
# e.g. Groq: https://api.groq.com/openai/v1 (with a Groq key and a Groq model in CHAT_MODEL)
CHAT_BASE_URL=

# Optional — comma-separated origins allowed to call the function. Empty = any origin.
ALLOWED_ORIGINS=

# Optional — raises the GitHub API rate limit for the repo lookup (a token with no scopes is enough)
GITHUB_TOKEN=
